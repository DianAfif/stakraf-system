# Copy to .env and set a unique, strong password before running.
POSTGRES_DB=stakraf
POSTGRES_USER=stakraf
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
# Public HTTPS URL when deploying behind an HTTPS reverse proxy.
APP_ORIGIN=http://localhost:3000
# Keep local unless a reverse proxy with TLS is configured.
STAKRAF_WEB_BIND=127.0.0.1
STAKRAF_SIGNUP_MODE=first_user
STAKRAF_SETUP_TOKEN=REPLACE_WITH_LONG_RANDOM_SETUP_SECRET
